# App
APP_NAME="Last Mile Delivery Tracker"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/lastmile"

# Security
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Email (Resend) - get API key from https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# SMS (Twilio) - get credentials from https://twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Frontend URL (for links in emails)
FRONTEND_URL="http://localhost:3000"